NEXT_PUBLIC_SITE_URL=https://simulaai-kappa.vercel.app
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Use only free-tier accounts without automatic paid billing.
GROQ_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
# Paid fallback is fail-closed. AI_PROVIDER_POLICY has precedence over FREE_AI_ONLY.
# Use free_only (default when unset) or free_then_paid. Never put real keys in this file.
OPENAI_API_KEY=
OPENAI_API_KEY_1=
OPENAI_API_KEY_2=
OPENAI_API_KEY_3=
OPENAI_API_KEY_4=
OPENAI_API_KEY_5=
AI_OPENAI_MODEL=
OPENAI_FALLBACK_MODELS=
# JSON must contain only models verified for the account and current OpenAI pricing.
OPENAI_PRICING_JSON=
OPENAI_MAX_CALLS_PER_DAY=0
OPENAI_MAX_SPEND_USD_PER_DAY=0
OPENAI_MAX_PAID_ATTEMPTS_PER_JOB=3
CRON_SECRET=

AI_GROQ_MODEL=
AI_GEMINI_MODEL=
AI_CEREBRAS_MODEL=
AI_GROQ_FREE_TIER_CONFIRMED=false
AI_GEMINI_FREE_TIER_CONFIRMED=false
AI_CEREBRAS_FREE_TIER_CONFIRMED=false
AI_OPENROUTER_MODEL=openrouter/free
# Fill with at most 3 explicit models approved by the live smoke matrix.
AI_OPENROUTER_MODEL_ORDER=
AI_EXTRACT_REASONING_POLICY=provider-default
AI_PROVIDER_ORDER=openrouter
AI_PROVIDER_POLICY=free_only
FREE_AI_ONLY=true
AI_ENABLED=true
COLLECTOR_ENABLED=true
MAX_AI_REQUESTS_PER_RUN=10
MAX_AI_REQUESTS_PER_DAY=50

# Collector
MAX_DOCUMENT_SIZE_MB=20
MAX_CONSECUTIVE_SOURCE_FAILURES=3
MAX_PENDING_AI_ALERT=20
MAX_PARSE_FAILURE_RATE=0.25

# Stripe Billing
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_ANNUAL=
STRIPE_PRICE_PREMIUM_ONE_TIME=
STRIPE_PAYMENT_LINK_PREMIUM_MONTHLY=
STRIPE_PAYMENT_LINK_PREMIUM_ANNUAL=
STRIPE_PAYMENT_LINK_PREMIUM_ONE_TIME=
STRIPE_PORTAL_LOGIN_URL=
